{
    "name": "Magentic Algo Trading Environment",
    "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
    "containerEnv": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/${localWorkspaceFolderBasename}/gcp_key.json",
        "GOOGLE_CLOUD_PROJECT": "datascience-projects"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.go",
                "eamodio.gitlens",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python"
            }
        }
    },
    "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install --no-cache-dir -r requirements.txt && .venv/bin/python -m ipykernel install --user --name=magentic_algo_venv --display-name \"Magentic Algo VEnv\"",
    "remoteUser": "vscode"
}